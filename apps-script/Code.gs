var ANSWER_KEY = {"start-here/what-is-rcm/#1":{"a":1,"w":"Billing, coding and contracting are all parts of RCM, but RCM is the whole chain, from scheduling and eligibility through payment and patient collections."},"start-here/what-is-rcm/#2":{"a":2,"w":"Providers bill their standard charge. In-network payers pay the contracted allowed amount, and the gap is a contractual adjustment (usually CO-45). It isn't a denial."},"start-here/what-is-rcm/#3":{"a":0,"w":"A clean claim is complete and correct, so nothing stops the payer from processing it. Being clean doesn't guarantee payment; the payer can still deny it for coverage, medical necessity or benefit reasons. A \"paid claim\" describes the outcome, not the claim's quality."},"start-here/what-is-rcm/#4":{"a":2,"w":"Scheduling, registration and eligibility happen before or at the visit (front end). Denials and AR follow-up happen after the claim is adjudicated (back end)."},"start-here/rcm-general-vs-healthcare/#1":{"a":1,"w":"Outside healthcare, the process from customer order to collected cash is called order-to-cash."},"start-here/rcm-general-vs-healthcare/#2":{"a":1,"w":"A retailer sets the price and the customer pays it. In healthcare, the payer decides coverage and the allowed amount after the service, and the patient pays only part."},"start-here/rcm-general-vs-healthcare/#3":{"a":0,"w":"Revenue management (or yield management) sets prices to maximise income. Revenue cycle management is about billing and collecting what's earned."},"start-here/provider-payer-patient/#1":{"a":1,"w":"The subscriber (also called the insured, member or policyholder) is the person who holds the policy, here the father. The child is a dependent."},"start-here/provider-payer-patient/#2":{"a":2,"w":"The NPI is a 10-digit number issued by CMS to every provider. Member ID, group number and MBI identify the patient or plan."},"start-here/provider-payer-patient/#3":{"a":0,"w":"The guarantor receives the patient statement and owes the patient balance. For an adult, the guarantor is usually the patient; for a child, usually a parent."},"start-here/provider-payer-patient/#4":{"a":1,"w":"Participating (par) or in-network providers have agreed to the payer's rates and rules. Non-par or out-of-network providers have no contract with that payer."},"start-here/ar-and-ap/#1":{"a":1,"w":"Accounts receivable is money owed to the provider. Unpaid claims and unpaid patient balances are both AR."},"start-here/ar-and-ap/#2":{"a":1,"w":"An overpayment creates a credit balance. The provider must refund it, so it behaves like accounts payable."},"start-here/ar-and-ap/#3":{"a":1,"w":"Teams prioritise by risk and value. Old claims risk timely filing denials, and high-dollar claims have the biggest effect on cash."},"start-here/ar-and-ap/#4":{"a":2,"w":"You need to know if the claim is on file, in process, paid or denied before acting. Resubmitting blindly creates duplicate denials."},"start-here/rcm-team-roles/#1":{"a":1,"w":"QA auditors review samples of each analyst's work, score accuracy, find error patterns and feed back to the team and trainers."},"start-here/rcm-team-roles/#2":{"a":1,"w":"Medical coders assign codes from documentation. Charge entry staff key the codes and charges into the billing system."},"start-here/rcm-team-roles/#3":{"a":0,"w":"Credentialing verifies a provider's qualifications and enrollment adds them to the payer's network and billing records."},"start-here/how-us-healthcare-is-paid/#1":{"a":1,"w":"Physician (professional) services are paid under the MPFS, which multiplies relative value units by a geographic adjustment and a conversion factor."},"start-here/how-us-healthcare-is-paid/#2":{"a":0,"w":"Under the Inpatient Prospective Payment System, Medicare pays a set amount per stay based on the MS-DRG, with some outlier adjustments."},"start-here/how-us-healthcare-is-paid/#3":{"a":1,"w":"Capitation pays a fixed per-member-per-month amount. Claims may still be submitted as encounter data, often adjusted with CO-24."},"start-here/how-us-healthcare-is-paid/#4":{"a":1,"w":"Minimum necessary means using or sharing only the PHI needed for the specific task."},"start-here/hipaa-and-compliance/#1":{"a":1,"w":"The Transactions and Code Sets Rule standardises electronic transactions (837, 835, 270/271 and others) and the code sets used in them."},"start-here/hipaa-and-compliance/#2":{"a":1,"w":"Vendors that handle PHI for a covered entity are business associates. The BAA binds them to HIPAA's privacy and security requirements."},"start-here/hipaa-and-compliance/#3":{"a":1,"w":"PHI sent outside approved, secured systems is a potential breach. It must be reported so the organisation can assess it and notify if required."},"rcm-cycle/scheduling-and-registration/#1":{"a":1,"w":"Demographic errors such as name spelling, date of birth and member ID are entered at registration. They surface later as rejections or denials such as CO-31 or CO-140."},"rcm-cycle/scheduling-and-registration/#2":{"a":1,"w":"The prefix identifies the member's home plan, which is how the BlueCard program routes out-of-area claims."},"rcm-cycle/scheduling-and-registration/#3":{"a":1,"w":"Collecting details days ahead gives time to verify coverage, get authorizations and correct mistakes before the claim exists."},"rcm-cycle/eligibility-and-benefits/#1":{"a":1,"w":"The 270 is the eligibility inquiry and the 271 is the payer's response. The 837 is the claim, the 835 is the remittance, and 276/277 is claim status."},"rcm-cycle/eligibility-and-benefits/#2":{"a":0,"w":"The patient first pays the remaining $300 of the deductible. The plan then covers 80% of the remaining $200, so the patient pays 20% of $200, which is $40. Total $340."},"rcm-cycle/eligibility-and-benefits/#3":{"a":1,"w":"Active coverage doesn't mean every service is covered. Excluded services deny as not covered under the benefit plan (CO-204) or non-covered (CO-96)."},"rcm-cycle/eligibility-and-benefits/#4":{"a":1,"w":"Patients lose jobs, change plans and age out of coverage. A check close to the date of service catches changes."},"rcm-cycle/prior-authorization-and-referrals/#1":{"a":1,"w":"A referral is the PCP's approval for a specialist visit, typical of HMO and POS plans. Prior authorization is the payer's approval of a specific service."},"rcm-cycle/prior-authorization-and-referrals/#2":{"a":1,"w":"Authorizations are valid only for the approved dates, units, codes and provider. A service outside the window is treated as unauthorized (CO-197, or CO-198 if limits were exceeded)."},"rcm-cycle/prior-authorization-and-referrals/#3":{"a":1,"w":"A pre-determination (or pre-treatment estimate) is an optional advance review. It isn't a guarantee of payment."},"rcm-cycle/prior-authorization-and-referrals/#4":{"a":1,"w":"The 278 is the health care services review request and response, used for prior authorizations and referrals."},"rcm-cycle/encounter-and-documentation/#1":{"a":1,"w":"Billing a higher level than documented (upcoding) causes overpayments that payers recover in audits. Repeated upcoding can be treated as fraud."},"rcm-cycle/encounter-and-documentation/#2":{"a":1,"w":"The 2021 E/M changes removed history and exam as level drivers for office visits. The level is chosen by MDM or total time."},"rcm-cycle/encounter-and-documentation/#3":{"a":1,"w":"The Advance Beneficiary Notice must be given before the service, when the provider expects Medicare may not pay. Without a valid ABN, the provider generally can't bill the patient for a medical necessity denial."},"rcm-cycle/medical-coding/#1":{"a":1,"w":"ICD-10-CM diagnosis codes explain the reason for the service. CPT and HCPCS describe what was done."},"rcm-cycle/medical-coding/#2":{"a":1,"w":"HCPCS Level II codes cover drugs (J-codes), supplies, DME, ambulance and other items not in CPT."},"rcm-cycle/medical-coding/#3":{"a":1,"w":"Unbundling splits a comprehensive service into its parts. NCCI edits catch many of these and deny the component code, often with CO-97 or CO-236."},"rcm-cycle/medical-coding/#4":{"a":1,"w":"ICD-10-PCS is used for inpatient hospital procedures on the UB-04. Physicians and outpatient settings use CPT and HCPCS."},"rcm-cycle/charge-entry/#1":{"a":0,"w":"Charge lag measures how long it takes to get a service into the billing system. Long lag delays cash and risks timely filing."},"rcm-cycle/charge-entry/#2":{"a":1,"w":"POS 21 is inpatient hospital. 11 is office, 22 is on-campus outpatient hospital, 23 is emergency department."},"rcm-cycle/charge-entry/#3":{"a":1,"w":"Charge reconciliation compares what happened (appointments, procedure logs, orders) with what was billed, so nothing is missed."},"rcm-cycle/claim-submission/#1":{"a":1,"w":"Rejections fail format or front-end checks and must be corrected and resubmitted as new claims. Denials were adjudicated and appear on the ERA; they need correction, reconsideration or appeal."},"rcm-cycle/claim-submission/#2":{"a":1,"w":"The 999 confirms the file's syntax was accepted. The 277CA (claim acknowledgment) reports whether each claim was accepted or rejected by the payer or clearinghouse."},"rcm-cycle/claim-submission/#3":{"a":1,"w":"An acceptance report showing the payer received the claim within the limit is the standard proof of timely filing."},"rcm-cycle/adjudication/#1":{"a":1,"w":"Payers first confirm the member and coverage. There's no point reviewing medical necessity for someone who isn't covered."},"rcm-cycle/adjudication/#2":{"a":1,"w":"A pended claim is in the payer's system but waiting, often for medical records, COB information from the patient, or a review."},"rcm-cycle/adjudication/#3":{"a":1,"w":"Medicare's payment floor means clean electronic claims aren't paid before day 14 (day 29 for paper). Most pay within about 30 days."},"rcm-cycle/payment-posting/#1":{"a":1,"w":"Contractual adjustment = billed − allowed = $250 − $150 = $100 (CO-45). Check $120 + $30 + $100 = $250."},"rcm-cycle/payment-posting/#2":{"a":1,"w":"Patient responsibility from the primary is billed to the secondary first. Only what the secondary doesn't cover goes to the patient."},"rcm-cycle/payment-posting/#3":{"a":1,"w":"Posting denials with their codes creates the data for denial reporting and puts the line in front of the right team quickly."},"rcm-cycle/payment-posting/#4":{"a":0,"w":"The trace number on the 835 matches the EFT reference, which is how payments are reconciled to deposits."},"rcm-cycle/denials-and-ar-follow-up/#1":{"a":1,"w":"A good note shows date, who and how contacted, reference number, status, reason, action and the next follow-up date."},"rcm-cycle/denials-and-ar-follow-up/#2":{"a":1,"w":"Denial management means fixing the claim AND preventing the next one. Root cause tracking is what reduces the denial rate over time."},"rcm-cycle/denials-and-ar-follow-up/#3":{"a":0,"w":"Corrected (replacement) claims fix billing errors. Appeals dispute the payer's decision when the claim was correct or needs clinical justification."},"rcm-cycle/patient-billing-and-collections/#1":{"a":1,"w":"Patients are billed the PR amounts (deductible, coinsurance, copay, or non-covered amounts they agreed to) after insurance processing."},"rcm-cycle/patient-billing-and-collections/#2":{"a":1,"w":"Providers must give uninsured and self-pay patients a good faith estimate of expected charges for scheduled services, and on request."},"rcm-cycle/patient-billing-and-collections/#3":{"a":1,"w":"The contractual adjustment (CO-45) can't be billed to the patient by in-network providers. Doing so is prohibited balance billing."},"rcm-cycle/reporting-and-kpis/#1":{"a":1,"w":"Days in AR = total AR ÷ average daily charges = $600,000 ÷ $20,000 = 30 days."},"rcm-cycle/reporting-and-kpis/#2":{"a":1,"w":"NCR = payments ÷ (charges − contractual adjustments) = $90,000 ÷ $100,000 = 90%."},"rcm-cycle/reporting-and-kpis/#3":{"a":1,"w":"Gross collection rate divides payments by billed charges, which are set by the provider. Net collection rate removes contractual adjustments, so it reflects collection effectiveness."},"insurance/types-of-plans/#1":{"a":1,"w":"HMOs use a primary care provider as gatekeeper, require referrals to specialists and generally cover only in-network care, except emergencies."},"insurance/types-of-plans/#2":{"a":0,"w":"EPOs usually don't need referrals (like PPOs) but only cover in-network care except emergencies (like HMOs)."},"insurance/types-of-plans/#3":{"a":1,"w":"Self-funded (ERISA) plans are paid by the employer, with an insurer or TPA processing claims. Plan rules and appeal rights follow ERISA, not state insurance law."},"insurance/types-of-payers/#1":{"a":1,"w":"Under BlueCard, providers file with their local (host) Blue plan, which uses the member prefix to route the claim to the home plan."},"insurance/types-of-payers/#2":{"a":1,"w":"Medicare Advantage plans are offered by private insurers under contract with CMS. They replace Original Medicare as the payer."},"insurance/types-of-payers/#3":{"a":1,"w":"Small plans and TPAs lease networks such as MultiPlan to access discounts. The network logo on the card tells you which contract and rates apply."},"insurance/medicare/#1":{"a":1,"w":"Part B covers physician services, outpatient care, preventive services, DME and more. Part A covers inpatient hospital, SNF, hospice and some home health."},"insurance/medicare/#2":{"a":1,"w":"Medigap supplements Original Medicare. Medicare pays first and, through crossover, forwards the claim to the Medigap insurer."},"insurance/medicare/#3":{"a":1,"w":"Medicare Advantage replaces Original Medicare for Part A and B services. Original Medicare denies, and the claim must be billed to the MA plan."},"insurance/medicare/#4":{"a":1,"w":"Under-65 eligibility is for people with qualifying disability (after 24 months of SSDI), end-stage renal disease or ALS (no waiting period)."},"insurance/medicaid-qmb-spend-down/#1":{"a":1,"w":"Providers may not bill QMB individuals for Medicare deductibles, coinsurance or copays, even when Medicaid pays less than the full amount."},"insurance/medicaid-qmb-spend-down/#2":{"a":1,"w":"Medicaid is the payer of last resort. Medicare pays first; Medicaid pays secondary for covered cost-sharing and services."},"insurance/medicaid-qmb-spend-down/#3":{"a":2,"w":"The spend-down is met once incurred expenses reach $600. The patient is responsible for the first $600 ($400 + $200), and Medicaid covers eligible expenses after that."},"insurance/medicaid-qmb-spend-down/#4":{"a":0,"w":"Federal rules allow up to three months of retroactive eligibility, although several states have waivers limiting it. Always check the state's rules."},"insurance/cobra/#1":{"a":1,"w":"COBRA lets employees and dependents keep their group plan after a qualifying event such as job loss, paying up to 102% of the premium."},"insurance/cobra/#2":{"a":2,"w":"COBRA election and first premium are retroactive. Claims denied for terminated coverage can be reprocessed once coverage is reinstated."},"insurance/cobra/#3":{"a":1,"w":"Termination of employment or reduced hours gives 18 months, extendable to 29 months for disability; some dependent events allow 36 months."},"insurance/tricare-and-va-ccn/#1":{"a":1,"w":"TRICARE For Life is a Medicare wraparound. Medicare pays first and TFL pays second for covered services."},"insurance/tricare-and-va-ccn/#2":{"a":1,"w":"Community care is paid by the VA only for care it has authorized (except certain emergencies notified in time). The referral or authorization number is required."},"insurance/tricare-and-va-ccn/#3":{"a":1,"w":"Medicaid is the payer of last resort, so TRICARE pays before Medicaid. TRICARE pays after most other health insurance."},"insurance/workers-comp-auto-pip/#1":{"a":1,"w":"Work-related injuries are the responsibility of the workers' compensation carrier. Health plans deny them with CO-19."},"insurance/workers-comp-auto-pip/#2":{"a":1,"w":"In no-fault states, each person's own PIP coverage pays their medical bills first, up to the policy limit, regardless of fault."},"insurance/workers-comp-auto-pip/#3":{"a":2,"w":"CARC 19 points to workers' comp, CARC 20 to a liability carrier, and CARC 21 to a no-fault (auto) carrier."},"insurance/workers-comp-auto-pip/#4":{"a":0,"w":"WC carriers match bills to an injury claim using the claim number, date of injury and employer. Missing them delays or denies payment."},"insurance/coordination-of-benefits/#1":{"a":1,"w":"The birthday rule uses only month and day. January 20 comes before March 15, so Dad's plan is primary. The year doesn't matter."},"insurance/coordination-of-benefits/#2":{"a":1,"w":"For working aged beneficiaries (65+), the employer plan is primary when the employer has 20 or more employees."},"insurance/coordination-of-benefits/#3":{"a":1,"w":"For disability-based Medicare, the group plan is primary only if the employer has 100 or more employees. With 50, Medicare is primary."},"insurance/coordination-of-benefits/#4":{"a":1,"w":"MA04 means the secondary payment can't be considered without the identity of or payment information from the primary payer."},"insurance/blue-cross-blue-shield/#1":{"a":1,"w":"Under BlueCard, providers file with their local (host) plan, which sends the claim to the member's home plan using the prefix."},"insurance/blue-cross-blue-shield/#2":{"a":1,"w":"FEP member IDs start with R and 8 digits. FEP has its own rules and claims processing."},"insurance/blue-cross-blue-shield/#3":{"a":1,"w":"The prefix (the first three characters) routes the claim to the right home plan or national account."},"forms-billing/cms-1500/#1":{"a":1,"w":"Box 23 holds the prior authorization number (or other approval numbers such as a CLIA number for some payers)."},"forms-billing/cms-1500/#2":{"a":0,"w":"Box 22 holds the frequency code, 7 to replace or 8 to void a prior claim, plus the original reference (ICN/DCN) number."},"forms-billing/cms-1500/#3":{"a":2,"w":"Box 33 is the billing provider (who gets paid). 24J is the rendering provider, 32 the service facility and 17 the referring provider."},"forms-billing/cms-1500/#4":{"a":1,"w":"24E holds up to four letters (A to L) pointing to diagnoses in box 21."},"forms-billing/ub-04/#1":{"a":1,"w":"011x is hospital inpatient. The fourth digit 1 means admit through discharge (a complete stay on one claim)."},"forms-billing/ub-04/#2":{"a":1,"w":"FL 42 holds the four-digit revenue code for each line. FL 4 is type of bill, FL 67 principal diagnosis, FL 76 attending provider."},"forms-billing/ub-04/#3":{"a":1,"w":"The last digit 7 means replacement of a prior claim. 013x is hospital outpatient, so 0137. Use 8 to void."},"forms-billing/ub-04/#4":{"a":0,"w":"Present on admission indicators (Y, N, U, W, 1) show whether each inpatient diagnosis existed at admission. They affect payment for hospital-acquired conditions."},"forms-billing/hospital-vs-professional-billing/#1":{"a":1,"w":"The radiologist bills the professional component with modifier 26. The hospital bills the technical component (equipment and staff) on its facility claim."},"forms-billing/hospital-vs-professional-billing/#2":{"a":1,"w":"Diagnostic services and related non-diagnostic services in the 3 days before admission (1 day for certain hospitals) are bundled into the inpatient claim."},"forms-billing/hospital-vs-professional-billing/#3":{"a":1,"w":"Observation is an outpatient service even though the patient is in a bed. It's billed on an outpatient TOB with observation hours."},"forms-billing/edi-transactions/#1":{"a":1,"w":"The 835 is the electronic remittance advice (ERA), explaining payments and adjustments by claim and line."},"forms-billing/edi-transactions/#2":{"a":1,"w":"The 276 asks for claim status; the 277 responds."},"forms-billing/edi-transactions/#3":{"a":1,"w":"Payers require ERA (and EFT) enrollment so they know where to send 835 files and payments."},"forms-billing/modifiers/#1":{"a":1,"w":"Modifier 25 marks a significant, separately identifiable E/M service on the same day as a procedure."},"forms-billing/modifiers/#2":{"a":0,"w":"Modifier 24 is for an unrelated E/M service by the same physician during a postoperative period."},"forms-billing/modifiers/#3":{"a":1,"w":"GA means a waiver of liability statement (ABN) was issued as required. GY means statutorily excluded; GZ means expected denial with no ABN."},"forms-billing/modifiers/#4":{"a":1,"w":"59 and XE/XS/XP/XU bypass NCCI edits only when services are truly distinct. Using them just to get paid is a common audit finding."},"forms-billing/corrected-claims/#1":{"a":1,"w":"A replacement (frequency 7) claim corrects billing data on an adjudicated claim. A new original would deny as a duplicate."},"forms-billing/corrected-claims/#2":{"a":1,"w":"Patient, subscriber and often billing provider changes can't be made by replacement. Void the original and submit a new claim."},"forms-billing/corrected-claims/#3":{"a":1,"w":"Medicare Part B handles minor clerical corrections through reopenings. Part A claims (UB-04) use replacement TOBs (xx7)."},"forms-billing/icd-10-cm-structure/#1":{"a":1,"w":"A is initial encounter (active treatment), D is subsequent encounter (routine healing care) and S is sequela (a late effect)."},"forms-billing/icd-10-cm-structure/#2":{"a":1,"w":"When a code needs a seventh character but has fewer than six characters, the placeholder X fills the gaps. Dropping it makes the code invalid."},"forms-billing/icd-10-cm-structure/#3":{"a":1,"w":"Follow-up visits during healing use D. Using A suggests active treatment, which auditors and payers flag."},"forms-billing/provider-identifiers/#1":{"a":1,"w":"Type 1 NPIs are for individuals; Type 2 NPIs are for organisations such as groups, hospitals and labs."},"forms-billing/provider-identifiers/#2":{"a":1,"w":"Payers pay against the TIN. An NPI-TIN pair that doesn't match the payer's enrollment record rejects or denies."},"forms-billing/provider-identifiers/#3":{"a":0,"w":"CLIA numbers are 10 characters, with the letter D in the third position."},"forms-billing/cdm-and-utilization-review/#1":{"a":1,"w":"A CDM error repeats on every claim. Fixing the master record stops the denials; affected claims still need correcting."},"forms-billing/cdm-and-utilization-review/#2":{"a":1,"w":"Continued stay (concurrent) review checks ongoing medical necessity for each additional day and the level of care."},"denials/what-is-a-denial/#1":{"a":1,"w":"PR-1 means the claim processed correctly and the patient owes the deductible. It's a valid zero payment, not a denial."},"denials/what-is-a-denial/#2":{"a":1,"w":"Soft denials are usually correctable (missing information, records needed). Hard denials are final unless appealed successfully, and often end in write-offs."},"denials/what-is-a-denial/#3":{"a":1,"w":"Most denials are preventable. Tracking where they start lets teams fix registration, authorization or coding processes."},"denials/read-an-era/#1":{"a":1,"w":"PR means patient responsibility. CARC 2 is coinsurance."},"denials/read-an-era/#2":{"a":1,"w":"The CO group code tells you the payer considers the amount the provider's liability under the contract or law."},"denials/read-an-era/#3":{"a":1,"w":"RARCs add detail (for example, which field is missing) or alerts. They don't stand alone as the reason for an adjustment."},"denials/denial-categories/#1":{"a":1,"w":"The denial is correct. The task is finding the right payer, or moving the balance to the patient if there is none and policy allows."},"denials/denial-categories/#2":{"a":1,"w":"If documentation supports a diagnosis that was left off, a coding-reviewed corrected claim fixes the denial. If the claim was right, appeal with records."},"denials/denial-categories/#3":{"a":1,"w":"B7 means the provider wasn't certified or eligible to be paid for the service on that date, typically a credentialing or enrollment gap."},"denials/hospital-vs-professional-denials/#1":{"a":1,"w":"Level-of-care denials dispute whether the stay met inpatient criteria. The fix usually involves physician advisor review, peer-to-peer and appeal with clinical documentation."},"denials/hospital-vs-professional-denials/#2":{"a":0,"w":"Clinical validation reviews question whether a documented diagnosis is supported by clinical indicators, often lowering the DRG."},"denials/hospital-vs-professional-denials/#3":{"a":1,"w":"Modifier-driven denials (25, 26, TC, 59, RT/LT) are a professional billing staple. DRG and readmission issues are facility issues."},"denials/appeals/#1":{"a":1,"w":"Level 1 redeterminations must be filed within 120 days of receiving the initial determination (the notice is presumed received 5 days after its date)."},"denials/appeals/#2":{"a":1,"w":"Winning appeals match the documentation to the payer's own written criteria and make it easy for the reviewer to say yes."},"denials/appeals/#3":{"a":1,"w":"Unprocessable claims (MA130) have no appeal rights. Fix the error and send a new claim."},"denials/preventing-denials/#1":{"a":1,"w":"Working denials recovers money; preventing them stops the work from existing. Root-cause fixes are what move the denial rate."},"denials/preventing-denials/#2":{"a":1,"w":"Typically a handful of causes (often eligibility, authorization and a few coding issues) drive most denials, so fixing them first gives the biggest gain."},"non-denials/rejections/#1":{"a":1,"w":"A rejected claim never entered adjudication, so there's no original claim to replace. Fix it and send a new claim."},"non-denials/rejections/#2":{"a":1,"w":"Until an accepted claim reaches the payer, timely filing isn't met. Old unworked rejections become CO-29 write-offs."},"non-denials/no-response-claims/#1":{"a":1,"w":"Not on file usually means it never reached the payer, was rejected, or went to the wrong payer ID or address."},"non-denials/no-response-claims/#2":{"a":1,"w":"Find the reason for the hold and act on it. Resubmitting a claim that's in process creates duplicates."},"non-denials/underpayments/#1":{"a":1,"w":"CO-45 should only reflect billed minus the contracted allowed amount. An allowed amount below contract is an underpayment to dispute."},"non-denials/underpayments/#2":{"a":1,"w":"Paid claims leave AR worklists. Without an expected-payment comparison, nobody notices the shortfall."},"non-denials/paid-not-received/#1":{"a":1,"w":"The trace number lets posting find the deposit and ERA. Confirming the bank account rules out payments sent to an old account."},"non-denials/paid-not-received/#2":{"a":1,"w":"Without an assignment of benefits honoured by the payer, the patient receives the check and owes the provider that amount."},"non-denials/secondary-and-crossover/#1":{"a":1,"w":"MA18 says the claim information was forwarded to the supplemental insurer. Don't bill the secondary separately unless the crossover fails."},"non-denials/secondary-and-crossover/#2":{"a":1,"w":"The crossover failed. Bill the secondary directly with the primary's adjudication."},"non-denials/credit-balances-and-refunds/#1":{"a":0,"w":"The patient owed $25 and paid $40, so there's a $15 patient credit. Policy may apply it to other open patient balances first, then refund the rest."},"non-denials/credit-balances-and-refunds/#2":{"a":1,"w":"Medicare and Medicaid overpayments must be reported and returned within 60 days after they are identified. Keeping them can create False Claims Act liability."},"non-denials/credit-balances-and-refunds/#3":{"a":2,"w":"A correct contractual adjustment reduces the balance to what's owed; it doesn't create a credit."},"non-denials/recoupments-and-offsets/#1":{"a":1,"w":"Recoupments taken from a check for other claims appear as PLB adjustments. Posters must apply them to the original claim."},"non-denials/recoupments-and-offsets/#2":{"a":1,"w":"Overpayment demands can be wrong. Review promptly, because dispute windows are short and silence usually means agreement."},"non-denials/payer-call-workflows/#1":{"a":1,"w":"Paper checks need mailing and processing time. Record the details and follow up after your team's waiting period (often around 30 business days) before asking for a trace or stop payment."},"non-denials/payer-call-workflows/#2":{"a":1,"w":"Posting needs the original claim to apply the takeback correctly, and AR needs the reason to decide whether to accept or dispute it."},"interview-prep/rapid-fire/#1":{"a":0,"w":"CARC 18 is an exact duplicate claim or service."},"interview-prep/rapid-fire/#2":{"a":1,"w":"24E points each line to diagnoses in box 21."},"interview-prep/rapid-fire/#3":{"a":1,"w":"013x is hospital outpatient."},"interview-prep/rapid-fire/#4":{"a":1,"w":"26 is the professional (interpretation) component."},"interview-prep/rapid-fire/#5":{"a":2,"w":"Original Medicare claims must be filed within one calendar year of the date of service."},"quality/audit-purpose-and-scope/#1":{"a":1,"w":"Process adherence measures whether the person did the work correctly against the standard. The outcome (a denial) had a cause outside their control. Mixing the two punishes people for payer behaviour and hides the real root cause."},"quality/audit-purpose-and-scope/#2":{"a":2,"w":"A usable scope names the population, period, standard (with version) and the checkpoints. Without them, results can't be repeated or compared."},"quality/audit-purpose-and-scope/#3":{"a":1,"w":"Work done under SOP v3.1 shouldn't be failed against a rule added in v3.2. Versioning keeps audits fair and makes trend comparisons honest."},"quality/sampling/#1":{"a":2,"w":"Margin ≈ 1.96 × √(0.9 × 0.1 ÷ 50) ≈ 1.96 × 0.042 ≈ 0.083, so roughly 82% to 98%. With 50 accounts, a single score can't separate a 90% performer from an 85% one."},"quality/sampling/#2":{"a":1,"w":"A targeted (judgmental) sample is chosen because it's likely to contain errors, so its error rate is biased upward for the person's work as a whole. Report it as a focused review finding."},"quality/sampling/#3":{"a":1,"w":"Stratifying by payer guarantees each payer is represented, while still selecting randomly inside each group. Taking the first accounts in a queue isn't random."},"quality/error-definitions-and-scoring/#1":{"a":0,"w":"Opportunity-based: (200 − 12) ÷ 200 = 94%. Account-based: 31 of 40 accounts had no error, so 31 ÷ 40 = 77.5%. The same work gives very different numbers, so always state the method."},"quality/error-definitions-and-scoring/#2":{"a":1,"w":"Billing a QMB patient for Medicare cost-sharing breaks a federal billing prohibition and harms the patient. Critical errors are defined by financial, compliance or patient impact."},"quality/error-definitions-and-scoring/#3":{"a":1,"w":"Vague definitions cause disagreement. Listing required elements makes the check objective, and calibration on shared examples confirms everyone applies it the same way."},"quality/calibration/#1":{"a":1,"w":"If 90% of accounts pass, two auditors who both say \"pass\" most of the time will agree a lot even if they judge carelessly. Kappa adjusts for that chance agreement."},"quality/calibration/#2":{"a":1,"w":"Kappa = (observed − expected) ÷ (1 − expected) = (0.86 − 0.6456) ÷ (1 − 0.6456) ≈ 0.2144 ÷ 0.3544 ≈ 0.60."},"quality/calibration/#3":{"a":1,"w":"Calibration exists to make the standard clearer. A ruling that isn't written down will be argued again next month."},"quality/root-cause-and-pareto/#1":{"a":2,"w":"The denial and the missing auth number are symptoms. The root cause is the process gap that let it happen: no step to update the authorization list when the plan changed."},"quality/root-cause-and-pareto/#2":{"a":1,"w":"Total is $95k. Eligibility ($42k) + authorization ($31k) = $73k, about 77%. Those are the first two to fix."},"quality/root-cause-and-pareto/#3":{"a":1,"w":"People make mistakes inside a process. Asking why the mistake was possible (unclear SOP, no system edit, no training on a new rule, unrealistic targets) finds a fix that protects everyone."},"quality/capa-feedback-and-coaching/#1":{"a":1,"w":"Recalling and refunding is the correction (fixing these accounts). Changing the process so it can't recur is corrective action. Applying the lesson to a new clinic before it has the problem is preventive action."},"quality/capa-feedback-and-coaching/#2":{"a":2,"w":"Completing the task doesn't prove it worked. An effectiveness check compares the measure before and after."},"quality/capa-feedback-and-coaching/#3":{"a":1,"w":"Specific, tied to the rule, with an example and a next step. The person knows exactly what to change."},"quality/ar-prioritization-and-work-queues/#1":{"a":1,"w":"A workable account with a deadline about to pass loses all recovery if it's missed. Deadline risk usually comes first; balance and recovery potential break ties."},"quality/ar-prioritization-and-work-queues/#2":{"a":1,"w":"Calling inside the normal processing window wastes a touch. Confirming acceptance now, then following up after the window, uses the payer's own timing. Resubmitting early risks a duplicate denial."},"quality/ar-prioritization-and-work-queues/#3":{"a":1,"w":"More touches per resolution means accounts aren't being resolved on the first effective action. Look at audit errors, note quality and payer turnaround to find out why."},"code/co-27":{"a":2,"w":"CO-27: Expenses incurred after coverage terminated. The patient's plan had ended before the date of service."},"code/co-26":{"a":1,"w":"CO-26: Expenses incurred prior to coverage. The date of service is before the patient's coverage started."},"code/co-31":{"a":3,"w":"CO-31: Patient cannot be identified as our insured. The payer can't find a member matching the name, date of birth and ID on the claim."},"code/co-32":{"a":2,"w":"CO-32: Patient is not an eligible dependent. The patient isn't covered as a dependent under this subscriber's policy."},"code/co-140":{"a":1,"w":"CO-140: Patient or insured name and ID do not match. The member ID on the claim belongs to someone with a different name."},"code/co-13":{"a":2,"w":"CO-13: The date of death precedes the date of service. The payer's records show the patient died before the date of service on the claim."},"code/co-22":{"a":3,"w":"CO-22: This care may be covered by another payer per coordination of benefits. The payer thinks another insurance should pay first."},"code/co-109":{"a":2,"w":"CO-109: Claim not covered by this payer; send to the correct payer. This payer isn't responsible for the claim. A different payer or contractor is."},"code/co-129":{"a":2,"w":"CO-129: Prior processing information appears incorrect. The primary payer's information on a secondary claim doesn't add up or doesn't match the payer's records."},"code/co-197":{"a":2,"w":"CO-197: Precertification, notification or authorization absent. The service needed prior authorization or notification, and the payer has none on file."},"code/co-198":{"a":2,"w":"CO-198: Precertification, notification or authorization exceeded. An authorization exists, but the service went beyond the approved units, visits or days."},"code/co-15":{"a":2,"w":"CO-15: Authorization number missing, invalid or does not apply. The authorization on the claim is wrong, invalid or belongs to another service or provider."},"code/co-242":{"a":3,"w":"CO-242: Services not provided by network or primary care providers. The plan only pays in-network or PCP-directed care, and this service wasn't."},"code/co-288":{"a":2,"w":"CO-288: Referral absent. The plan requires a referral from the primary care provider, and none is on file."},"code/co-16":{"a":1,"w":"CO-16: Claim lacks information or has submission or billing errors. Something on the claim is missing or invalid. The remark code says what."},"code/co-4":{"a":0,"w":"CO-4: Procedure code inconsistent with the modifier, or a required modifier is missing. The modifier is wrong for the code, or a modifier the payer requires isn't there."},"code/co-11":{"a":1,"w":"CO-11: Diagnosis inconsistent with the procedure. The diagnosis on the line doesn't support the procedure billed."},"code/co-5":{"a":2,"w":"CO-5: Procedure code or type of bill inconsistent with the place of service. The service can't be billed with the place of service or bill type used."},"code/co-6":{"a":1,"w":"CO-6: Procedure or revenue code inconsistent with the patient's age. The code is meant for a different age group than the patient's."},"code/co-146":{"a":2,"w":"CO-146: Diagnosis was invalid for the date of service. The ICD-10-CM code wasn't valid on the date of service, or isn't billable."},"code/co-181":{"a":2,"w":"CO-181: Procedure code was invalid on the date of service. The CPT or HCPCS code was deleted or not yet effective on the date of service."},"code/co-189":{"a":0,"w":"CO-189: Unlisted or NOC code billed when a specific code exists. A \"not otherwise classified\" or unlisted code was used even though a specific code describes the service."},"code/co-199":{"a":3,"w":"CO-199: Revenue code and procedure code do not match. On a facility claim, the revenue code doesn't fit the HCPCS code on the same line."},"code/co-b16":{"a":1,"w":"CO-B16: New patient qualifications were not met. A new patient E/M code was billed for a patient the payer considers established."},"code/co-58":{"a":3,"w":"CO-58: Treatment rendered in an inappropriate or invalid place of service. The payer says the service shouldn't have been provided, or billed, in the setting on the claim."},"code/co-7":{"a":2,"w":"CO-7: Procedure or revenue code inconsistent with the patient's sex. The service is normally limited to one sex, and the patient's sex on file doesn't match."},"code/co-9":{"a":3,"w":"CO-9: Diagnosis inconsistent with the patient's age. The diagnosis code is defined for a different age group than the patient's."},"code/co-10":{"a":1,"w":"CO-10: Diagnosis inconsistent with the patient's sex. The diagnosis is normally limited to one sex, and the patient's sex on file is the other."},"code/co-182":{"a":2,"w":"CO-182: Procedure modifier was invalid on the date of service. A modifier on the claim didn't exist or wasn't valid on the date of service."},"code/co-97":{"a":0,"w":"CO-97: Benefit included in the payment for another service already adjudicated. The payer bundled this service into another service paid on the same claim or day."},"code/co-236":{"a":1,"w":"CO-236: Procedure or modifier combination not compatible under NCCI. An NCCI procedure-to-procedure edit denied this line."},"code/co-234":{"a":3,"w":"CO-234: This procedure is not paid separately. The payer doesn't pay this code on its own, such as packaged services or add-on items."},"code/co-50":{"a":1,"w":"CO-50: Non-covered service because it is not deemed a medical necessity by the payer. The payer says the service wasn't medically necessary for the diagnosis or circumstances."},"code/co-167":{"a":2,"w":"CO-167: This diagnosis is not covered. The diagnosis on the claim isn't covered by the plan for this service."},"code/co-96":{"a":3,"w":"CO-96: Non-covered charge(s). The plan doesn't cover this service, usually with a remark code explaining why."},"code/co-204":{"a":2,"w":"CO-204: Service, equipment or drug not covered under the patient's current benefit plan. The member's specific plan doesn't include this benefit."},"code/co-55":{"a":2,"w":"CO-55: Procedure, treatment or drug deemed experimental or investigational. The payer considers the service experimental or not proven."},"code/co-49":{"a":0,"w":"CO-49: Routine or preventive service not covered. A routine exam, or a screening done with a routine exam, isn't covered by the plan."},"code/co-b9":{"a":0,"w":"CO-B9: Patient is enrolled in a hospice. The patient has elected Medicare hospice, so related services belong to the hospice."},"code/co-51":{"a":0,"w":"CO-51: Non-covered because this is a pre-existing condition. The plan excludes the condition as pre-existing. Rare today because the ACA bans this for most plans."},"code/co-150":{"a":0,"w":"CO-150: Information submitted does not support this level of service. The payer thinks the level billed (often an E/M level) is higher than the diagnosis or records support."},"code/co-119":{"a":2,"w":"CO-119: Benefit maximum for this time period or occurrence has been reached. The patient has used up the plan's limit for this service."},"code/co-151":{"a":3,"w":"CO-151: Information submitted does not support this many or this frequency of services. The units or frequency billed exceed what the payer accepts for this code."},"code/co-18":{"a":1,"w":"CO-18: Exact duplicate claim or service. The payer already has the same claim or line for this patient, provider and date."},"code/co-b13":{"a":2,"w":"CO-B13: Previously paid. Payment for this service may already have been made on another claim."},"code/co-b20":{"a":0,"w":"CO-B20: Procedure or service partially or fully furnished by another provider. The payer already paid another provider for the same service on the same date."},"code/co-29":{"a":1,"w":"CO-29: The time limit for filing has expired. The payer received the claim after its timely filing deadline."},"code/co-b7":{"a":1,"w":"CO-B7: Provider not certified or eligible to be paid for this service on this date. The payer has no active enrollment or certification for this provider on the date of service."},"code/co-185":{"a":2,"w":"CO-185: Rendering provider is not eligible to perform the service billed. The rendering provider's type, specialty or enrollment doesn't allow this service."},"code/co-170":{"a":1,"w":"CO-170: Payment is denied when performed or billed by this type of provider. The payer doesn't pay this service from this provider type."},"code/co-208":{"a":0,"w":"CO-208: National Provider Identifier (NPI) not matched. The NPI on the claim doesn't match the payer's records for this provider."},"code/co-8":{"a":2,"w":"CO-8: Procedure code inconsistent with the provider type or specialty (taxonomy). The payer doesn't expect this service from the rendering provider's specialty on file."},"code/co-183":{"a":0,"w":"CO-183: The referring provider is not eligible to refer the service billed. The provider in box 17 isn't enrolled or allowed to order or refer this service."},"code/co-19":{"a":3,"w":"CO-19: Work-related injury or illness; liability of the workers' compensation carrier. The health plan believes workers' comp should pay because the injury is work-related."},"code/co-20":{"a":3,"w":"CO-20: Injury or illness covered by the liability carrier. The health plan believes a liability insurer (another party) should pay."},"code/co-21":{"a":3,"w":"CO-21: Injury or illness is the liability of the no-fault carrier. The health plan believes auto no-fault (PIP) coverage should pay first."},"code/co-226":{"a":3,"w":"CO-226: Information requested from the provider was not provided, was late, or was insufficient. The payer asked for records or information and didn't get what it needed in time."},"code/pr-227":{"a":0,"w":"PR-227: Information requested from the patient was not provided or was insufficient. The payer is waiting on the member, usually a COB, accident or other questionnaire."},"code/co-252":{"a":0,"w":"CO-252: An attachment or other documentation is required to adjudicate this claim. The payer needs an attachment (records, invoice, report) before it can process the claim."},"code/co-163":{"a":0,"w":"CO-163: Attachment or other documentation referenced on the claim was not received. The claim said documents were coming, but the payer never matched them to the claim."},"code/ma04":{"a":3,"w":"MA04: Secondary payment needs the primary payer's information. The secondary payer can't process the claim without the primary payer's identity or payment details."},"code/m119":{"a":2,"w":"M119: Missing, incomplete, invalid, deactivated or withdrawn NDC. A drug line has no NDC, or the NDC is wrong, inactive or in the wrong format."},"code/ma120":{"a":0,"w":"MA120: Missing, incomplete or invalid CLIA certification number. A lab test was billed without a valid CLIA number for the testing site."},"code/co-45":{"a":3,"w":"CO-45: Charge exceeds fee schedule or contracted amount. The contractual write-off between the billed charge and the allowed amount. Not a denial."},"code/pr-1":{"a":1,"w":"PR-1: Deductible amount. The patient's deductible. Bill the secondary payer or the patient."},"code/pr-2":{"a":0,"w":"PR-2: Coinsurance amount. The patient's percentage share of the allowed amount."},"code/pr-3":{"a":2,"w":"PR-3: Co-payment amount. The patient's fixed copay for the visit or service."},"code/co-24":{"a":0,"w":"CO-24: Charges covered under a capitation agreement or managed care plan. The provider is paid a fixed monthly amount for this patient, so the line pays $0."},"code/oa-23":{"a":2,"w":"OA-23: Impact of prior payer adjudication, including payments and adjustments. On a secondary claim, the amount already handled by the primary payer."},"code/co-253":{"a":1,"w":"CO-253: Sequestration, reduction in federal payment. Medicare's 2% payment reduction required by federal law."},"code/pr-100":{"a":0,"w":"PR-100: Payment made to the patient, insured or responsible party. The payer paid the patient instead of the provider. The patient now owes the provider that amount."},"spec/allergy-immunology":{"a":0,"w":"95004 belongs to Allergy and immunology. Allergy testing counted by number of tests, and immunotherapy split into antigen preparation and injection codes."},"spec/ambulance":{"a":1,"w":"A0429 belongs to Ambulance services. Emergency and non-emergency transport billed by level of service plus mileage, with origin and destination modifiers."},"spec/anesthesiology":{"a":3,"w":"00100–01999 belongs to Anesthesiology. Time-based billing using base units plus time units, physical status modifiers and medical direction rules."},"spec/behavioral-health":{"a":0,"w":"90791 belongs to Behavioral health (psychiatry and psychotherapy). Psychiatric evaluations, time-based psychotherapy, medication management and telehealth, often carved out to a separate behavioral health payer."},"spec/cardiology":{"a":2,"w":"93000 belongs to Cardiology. Heart and vascular care with heavy diagnostic testing, professional and technical component splits, and frequent prior authorization."},"spec/chiropractic":{"a":1,"w":"98940 belongs to Chiropractic. Spinal manipulation billed by number of regions, with Medicare's active-treatment rule and the AT modifier."},"spec/dermatology":{"a":1,"w":"11102 / 11103 belongs to Dermatology. Skin exams and many small procedures: biopsies, destructions, excisions and Mohs surgery, where size, count and site drive the code."},"spec/dme":{"a":1,"w":"E0601 belongs to Durable medical equipment (DME). Equipment and supplies billed with HCPCS codes, rental versus purchase rules, written orders, proof of delivery and DME MAC policies."},"spec/emergency-medicine":{"a":0,"w":"99281–99285 belongs to Emergency medicine and urgent care. ED visit levels, critical care time, procedures in the ED, the No Surprises Act and the prudent layperson standard."},"spec/endocrinology":{"a":0,"w":"95250 belongs to Endocrinology. Diabetes, thyroid and hormone care with continuous glucose monitors, insulin pumps and thyroid biopsies."},"spec/ent":{"a":0,"w":"31231 belongs to ENT (otolaryngology) and audiology. Ear, nose and throat procedures in the office and OR, hearing tests, and the hearing aid exclusions most plans apply."},"spec/gastroenterology":{"a":3,"w":"45378 belongs to Gastroenterology. Endoscopy-heavy specialty where screening versus diagnostic colonoscopy rules change what the patient owes."},"spec/general-surgery":{"a":3,"w":"47562 belongs to General surgery. Abdominal, hernia, gallbladder, breast and skin surgery with 90-day globals, assistant surgeon rules and multiple procedure reductions."},"spec/home-health-hospice":{"a":0,"w":"TOB 032x belongs to Home health and hospice. Institutional billing for care in the home, with 30-day home health periods, hospice benefit periods and certification rules."},"spec/hospital-medicine":{"a":3,"w":"99221–99223 belongs to Hospital medicine (hospitalists). Inpatient and observation visits, admissions, discharges and split-shared services, with daily one-visit rules."},"spec/infusion-rheumatology":{"a":1,"w":"96365 / 96366 belongs to Infusion therapy and rheumatology. Biologic drug infusions for autoimmune disease, with the infusion hierarchy, drug units, site-of-care rules and step therapy."},"spec/laboratory-pathology":{"a":2,"w":"80053 belongs to Laboratory and pathology. Lab tests and pathology billed with CLIA numbers, ordering providers, panels, medical necessity diagnosis lists and frequency limits."},"spec/nephrology":{"a":0,"w":"90960 / 90961 / 90962 belongs to Nephrology and dialysis. Kidney care and monthly ESRD capitation-style billing, dialysis facility claims, and the ESRD Medicare coordination period."},"spec/neurology":{"a":1,"w":"95816 belongs to Neurology. Nervous system care with diagnostic testing such as EEG, EMG and nerve conduction studies, Botox for migraine and infusion therapies."},"spec/obgyn":{"a":2,"w":"59400 belongs to Obstetrics and gynecology. Pregnancy care billed as global packages, gynecologic exams and procedures, with complex global and split-billing rules."},"spec/oncology":{"a":2,"w":"96413 belongs to Oncology and hematology. Chemotherapy and infusion administration hierarchies, high-cost drugs with units and wastage, and strict prior authorization."},"spec/ophthalmology":{"a":2,"w":"92002 / 92004 belongs to Ophthalmology and optometry. Eye exams, diagnostic imaging and eye surgery, with a choice between eye exam codes and E/M codes, and routine vision versus medical coverage."},"spec/orthopedics":{"a":2,"w":"20610 / 20611 belongs to Orthopedics. Bones, joints and muscles. Joint injections, fracture care, arthroscopy and joint replacement, with global surgery periods and laterality."},"spec/pain-management":{"a":0,"w":"62321 belongs to Pain management. Interventional spine procedures with strict LCD criteria, frequency limits, imaging guidance and prior authorization."},"spec/pediatrics":{"a":3,"w":"99381–99385 / 99391–99395 belongs to Pediatrics. Well-child visits, vaccines, newborn care and sick visits for patients up to age 18 or 21, heavily paid by Medicaid and CHIP."},"spec/therapy":{"a":0,"w":"97161 / 97162 / 97163 belongs to Physical, occupational and speech therapy. Timed therapy codes billed in 15-minute units under the 8-minute rule, with plans of care, visit limits and the KX threshold."},"spec/plastic-surgery":{"a":2,"w":"15823 belongs to Plastic and reconstructive surgery. Where the line between cosmetic and reconstructive decides everything, from blepharoplasty to breast reconstruction."},"spec/podiatry":{"a":1,"w":"11720 / 11721 belongs to Podiatry. Foot and ankle care, where Medicare's routine foot care exclusion and class findings decide whether nail and callus care is payable."},"spec/primary-care":{"a":1,"w":"99202–99205 belongs to Primary care (family and internal medicine). Office visits, preventive exams, chronic disease management and care coordination, the highest-volume work in professional billing."},"spec/pulmonology":{"a":2,"w":"94010 belongs to Pulmonology and sleep medicine. Lung care with pulmonary function tests, bronchoscopy, sleep studies and CPAP, plus Medicare's CPAP compliance rule."},"spec/radiology":{"a":3,"w":"71046 belongs to Radiology and imaging. X-ray, CT, MRI, ultrasound and mammography billed in professional and technical components, with heavy prior authorization and ordering-provider rules."},"spec/urology":{"a":2,"w":"52000 belongs to Urology. Urinary tract and male reproductive care with cystoscopy, prostate biopsy, lithotripsy and drug injections for prostate cancer."}};

/* Returns the latest answer key from the site (cached for 30 minutes),
   falling back to the copy embedded above. */
function getKey_() {
  if (!CONFIG.KEY_URL) return ANSWER_KEY;
  var cache = CacheService.getScriptCache();
  var cached = cache.get("key-v2");
  if (cached) { try { return JSON.parse(cached); } catch (e) {} }
  try {
    var res = UrlFetchApp.fetch(CONFIG.KEY_URL, { muteHttpExceptions: true });
    if (res.getResponseCode() === 200) {
      var text = res.getContentText();
      var parsed = JSON.parse(text);
      if (parsed && Object.keys(parsed).length > 50) {
        if (text.length < 95000) cache.put("key-v2", text, 1800);
        return parsed;
      }
    }
  } catch (e) {}
  return ANSWER_KEY;
}

/* ------------------------------------------------------------ web entry points */

function doGet(e) {
  var p = (e && e.parameter) || {};
  if (p.action === "verify") return json_(verifyCertificate_(String(p.id || "")));
  if (p.action === "ping") return json_({ ok: true, keyVersion: CONFIG.KEY_VERSION, questions: Object.keys(getKey_()).length });
  return json_({ ok: false, error: "Unknown action." });
}

function doPost(e) {
  var body;
  try { body = JSON.parse(e.postData.contents); } catch (err) { return json_({ ok: false, error: "The request could not be read." }); }
  if (body.action !== "submit") return json_({ ok: false, error: "Unknown action." });
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    return json_(submitExam_(body, new Date()));
  } finally {
    lock.releaseLock();
  }
}

/* ------------------------------------------------------------ core logic (pure, testable) */

function cleanName_(name) {
  // Keep letters, combining marks, spaces, full stops, apostrophes and hyphens only.
  return String(name || "").replace(/[^\p{L}\p{M} .'\u2019-]/gu, "").replace(/\s+/g, " ").trim().slice(0, 80);
}

function scoreAttempt_(ids, answers) {
  if (!Array.isArray(ids) || !Array.isArray(answers)) return { error: "Answers are missing." };
  if (ids.length !== CONFIG.QUESTIONS || answers.length !== ids.length) return { error: "The exam must have " + CONFIG.QUESTIONS + " questions." };
  var KEY = getKey_();
  var seen = {};
  var results = [];
  var correct = 0;
  for (var i = 0; i < ids.length; i++) {
    var id = String(ids[i]);
    if (seen[id]) return { error: "Duplicate question in the exam." };
    seen[id] = true;
    var k = KEY[id];
    if (!k) return { error: "The exam questions are out of date. Reload the page and start again.", stale: true };
    var given = answers[i] === null || answers[i] === undefined ? -1 : Number(answers[i]);
    var ok = given === k.a;
    if (ok) correct++;
    results.push({ id: id, correct: ok, answer: k.a, why: k.w });
  }
  var percent = Math.round(correct / ids.length * 1000) / 10;
  return { correct: correct, total: ids.length, percent: percent, passed: percent >= CONFIG.PASS_PERCENT, results: results };
}

function makeCertId_(date) {
  var chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  var s = "";
  for (var i = 0; i < 8; i++) s += chars.charAt(Math.floor(Math.random() * chars.length));
  var ym = date.getFullYear() + ("0" + (date.getMonth() + 1)).slice(-2);
  return "RVX-" + ym + "-" + s;
}

function submitExam_(body, now) {
  var name = cleanName_(body.name);
  if (name.length < 2) return { ok: false, error: "Enter your full name as it should appear on the certificate." };
  var score = scoreAttempt_(body.ids, body.answers);
  if (score.error) return { ok: false, error: score.error, stale: !!score.stale };
  var store = store_();
  store.addAttempt([now.toISOString(), name, score.correct, score.total, score.percent, score.passed ? "Passed" : "Not passed"]);
  var out = { ok: true, name: name, correct: score.correct, total: score.total, percent: score.percent, passed: score.passed, results: score.results };
  if (score.passed) {
    var id = makeCertId_(now);
    while (store.findCert(id)) id = makeCertId_(now);
    store.addCert([id, name, score.percent, score.correct + "/" + score.total, now.toISOString(), CONFIG.CERT_NAME, "Valid"]);
    out.certId = id;
    out.issued = now.toISOString();
    out.certName = CONFIG.CERT_NAME;
  }
  return out;
}

function verifyCertificate_(id) {
  id = String(id || "").toUpperCase().trim();
  if (!/^RVX-\d{6}-[A-Z0-9]{8}$/.test(id)) return { ok: true, valid: false, reason: "That isn't a valid certificate ID format." };
  var row = store_().findCert(id);
  if (!row) return { ok: true, valid: false, reason: "No certificate with this ID was found." };
  if (row[6] && row[6] !== "Valid") return { ok: true, valid: false, reason: "This certificate has been revoked." };
  // Only what's needed to confirm the certificate; the score stays private.
  return { ok: true, valid: true, id: row[0], name: row[1], issued: row[4], certName: row[5] };
}

/* ------------------------------------------------------------ storage (Google Sheets) */

function store_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  function sheet(name, header) {
    var sh = ss.getSheetByName(name);
    if (!sh) { sh = ss.insertSheet(name); sh.appendRow(header); sh.setFrozenRows(1); }
    return sh;
  }
  var certs = sheet(CONFIG.CERT_SHEET, ["Certificate ID", "Name", "Percent", "Score", "Issued (UTC)", "Certificate", "Status"]);
  var attempts = sheet(CONFIG.ATTEMPT_SHEET, ["Time (UTC)", "Name", "Correct", "Total", "Percent", "Result"]);
  return {
    addAttempt: function (r) { attempts.appendRow(r); },
    addCert: function (r) { certs.appendRow(r); },
    findCert: function (id) {
      var found = certs.getRange("A:A").createTextFinder(id).matchEntireCell(true).findNext();
      if (!found || found.getRow() === 1) return null;
      return certs.getRange(found.getRow(), 1, 1, 7).getValues()[0];
    }
  };
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

/* Run this once from the editor to create the sheets and approve permissions. */
function setup() {
  store_();
  Logger.log("REVEX certification is ready. Questions in key: " + Object.keys(ANSWER_KEY).length);
}
